# PostgreSQL Database Connection URL
DATABASE_URL="postgresql://tikuser:tikuser_secret@localhost:5432/tikuser_db?schema=public"

# Fastify Server Configuration
PORT=3000
HOST="0.0.0.0"
NODE_ENV="development"
LOG_LEVEL="info"

# WebSocket & Realtime Configuration
WS_HEARTBEAT_INTERVAL_MS=30000
WS_TICKET_TTL_SECONDS=60
WS_MAX_CONNECTIONS_PER_TENANT=50

# TikTok LIVE Connector Mode ("mock" | "live")
TIKTOK_CONNECTOR_MODE="mock"
USE_MOCK_CONNECTOR="false"

# Euler Stream sign-server key, required to receive LIVE events in live mode
TIKTOK_SIGN_API_KEY=""

# Fetch the gift catalogue on connect (requires Euler Business plan; gift data is already on each event)
TIKTOK_EXTENDED_GIFT_INFO="false"

# Voice Studio Text-to-Speech Settings
# 1. CIT Voice Studio (Vietnamese TTS, 100% offline desktop app): https://github.com/Cuongyd196/cit-voice-studio
CIT_VOICE_STUDIO_URL="http://127.0.0.1:8001"
# 2. debpalash/VoiceStudio (Local ElevenLabs alternative): https://github.com/debpalash/VoiceStudio
VOICE_STUDIO_URL="http://localhost:3900"
VOICE_STUDIO_API_KEY=""
VOICE_STUDIO_DEFAULT_VOICE="Minh Đức"
VOICE_STUDIO_ENABLED="true"
